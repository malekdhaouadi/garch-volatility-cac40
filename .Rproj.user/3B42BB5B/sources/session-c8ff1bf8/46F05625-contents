# Statistical tests, backtests and loss functions. Base R only, no side effects.

# ---- ARCH-LM test (centered R^2; validated against FinTS::ArchTest) ----
arch_lm_test <- function(x, q) {
  y   <- x^2
  X   <- embed(y, q + 1)                     # column 1 = y_t, other columns = lags
  fit <- lm(X[, 1] ~ X[, -1])                # intercept included: centered R^2
  lm_stat <- nrow(X) * summary(fit)$r.squared
  list(statistic = lm_stat, df = q,
       p.value = pchisq(lm_stat, df = q, lower.tail = FALSE))
}

# ---- HAC helpers (Newey-West, Bartlett kernel) ----
# Standard error of a sample mean
nw_se <- function(x, lag = 20) {
  n <- length(x)
  stopifnot(lag >= 1, n > lag + 1)
  x <- x - mean(x)
  s <- sum(x^2) / n
  for (k in seq_len(lag))
    s <- s + 2 * (1 - k / (lag + 1)) * sum(x[(k + 1):n] * x[1:(n - k)]) / n
  sqrt(s / n)
}

# Diebold-Mariano on a loss differential d = L1 - L2 (stat > 0: model 2 has the lower loss)
dm_hac <- function(d, lag = 20) {
  z <- mean(d) / nw_se(d, lag)
  c(stat = z, p = 2 * pnorm(-abs(z)))
}
dm_plain <- function(d) {
  z <- mean(d) / (sd(d) / sqrt(length(d)))
  c(stat = z, p = 2 * pnorm(-abs(z)))
}

# OLS of y on X (intercept added) with Newey-West covariance
ols_hac <- function(y, X, lag = 20) {
  X <- cbind(1, X); n <- nrow(X)
  XtXi <- solve(crossprod(X))
  b <- as.numeric(XtXi %*% crossprod(X, y))
  e <- as.numeric(y - X %*% b)
  u <- X * e
  S <- crossprod(u) / n
  for (l in seq_len(lag)) {
    G <- crossprod(u[(l + 1):n, , drop = FALSE], u[1:(n - l), , drop = FALSE]) / n
    S <- S + (1 - l / (lag + 1)) * (G + t(G))
  }
  V <- n * XtXi %*% S %*% XtXi
  list(b = b, se = sqrt(diag(V)), n = n,
       r2 = 1 - sum(e^2) / sum((y - mean(y))^2))
}

# ---- Losses ----
qlike <- function(r, f) r / f - log(r / f) - 1          # r = realized proxy, f = forecast variance
tick  <- function(r, q, alpha) (alpha - (r < q)) * (r - q)   # quantile (pinball) loss

# ---- VaR / ES backtests ----
xlogy <- function(x, y) ifelse(x == 0, 0, x * log(y))

# Kupiec unconditional coverage (POF); v = logical exceedance indicator
kupiec <- function(v, alpha) {
  n <- length(v); x <- sum(v); p <- x / n
  ll <- function(q) xlogy(n - x, 1 - q) + xlogy(x, q)
  LR <- -2 * (ll(alpha) - ll(p))
  c(LR = LR, p = pchisq(LR, 1, lower.tail = FALSE))
}

# Christoffersen independence test
christoffersen_ind <- function(v) {
  v <- as.integer(v); a <- v[-length(v)]; b <- v[-1]
  n00 <- sum(a == 0 & b == 0); n01 <- sum(a == 0 & b == 1)
  n10 <- sum(a == 1 & b == 0); n11 <- sum(a == 1 & b == 1)
  p01 <- n01 / (n00 + n01); p11 <- ifelse(n10 + n11 == 0, 0, n11 / (n10 + n11))
  p   <- (n01 + n11) / (n00 + n01 + n10 + n11)
  ll0 <- xlogy(n00 + n10, 1 - p) + xlogy(n01 + n11, p)
  ll1 <- xlogy(n00, 1 - p01) + xlogy(n01, p01) + xlogy(n10, 1 - p11) + xlogy(n11, p11)
  LR <- -2 * (ll0 - ll1)
  c(LR = LR, p = pchisq(LR, 1, lower.tail = FALSE))
}

# Dynamic quantile test (Engle-Manganelli): returns the p-value
dq_test <- function(v, VaR, a, lags = 4) {
  h <- as.numeric(v) - a; n <- length(h)
  if (n < lags + 20) return(NA_real_)
  idx <- (lags + 1):n
  X <- cbind(1, sapply(seq_len(lags), function(l) h[idx - l]), VaR[idx]); y <- h[idx]
  b <- tryCatch(solve(crossprod(X), crossprod(X, y)), error = function(e) NULL)
  if (is.null(b)) return(NA_real_)
  stat <- as.numeric(t(b) %*% crossprod(X) %*% b) / (a * (1 - a))
  pchisq(stat, df = ncol(X), lower.tail = FALSE)
}

# McNeil-Frey: on VaR exceedances (r - ES)/sigma should have mean zero.
# p_less is the one-sided p-value for "losses are worse than the forecast ES".
es_test <- function(r, VaR, ES, sig) {
  v <- r < VaR
  if (sum(v) < 5) return(c(mean_resid = NA, p_two = NA, p_less = NA))
  d  <- (r[v] - ES[v]) / sig[v]
  tt <- t.test(d)
  c(mean_resid = unname(tt$estimate), p_two = tt$p.value,
    p_less = pt(unname(tt$statistic), tt$parameter))
}
