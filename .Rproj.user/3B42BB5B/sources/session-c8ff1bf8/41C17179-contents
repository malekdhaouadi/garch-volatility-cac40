# Rolling forecasts. Requires library(rugarch) to be attached; uses fit_safe() from R/models.R.
#
# Index conventions (x is a numeric vector of returns):
#   roll_avg_vol(): idx is the forecast ORIGIN; the forecast uses data up to and including x[idx].
#   roll_risk(), hs_risk(): idx is the TARGET day; forecasts use data up to x[idx - 1].

tag <- function(a) sprintf("%03d", round(a * 1000))

# H-day average volatility forecast (annualized, %) at every origin i0..n.
# One moving-window fit per block of `refit_every` origins; parameters fixed inside a block.
roll_avg_vol <- function(x, i0, model, window, refit_every, horizon = 21,
                         mean0 = FALSE, dist = "std", ann = sqrt(252) * 100,
                         verbose = FALSE) {
  n <- length(x)
  stopifnot(i0 >= window)
  starts <- seq(i0, n, by = refit_every)
  res <- vector("list", length(starts)); n_fail <- 0
  for (k in seq_along(starts)) {
    s <- starts[k]; e <- min(s + refit_every - 1, n); m <- e - s
    fit <- fit_safe(model, x[(s - window + 1):e], m, mean0, dist)
    if (is.null(fit)) {
      n_fail <- n_fail + 1
      res[[k]] <- data.frame(idx = s:e, fc = NA_real_)
    } else {
      sg <- as.matrix(sigma(ugarchforecast(fit, n.ahead = horizon, n.roll = m)))
      res[[k]] <- data.frame(idx = s:e, fc = sqrt(colMeans(sg^2)) * ann)
    }
    if (verbose && k %% 10 == 0) message(sprintf("  %s: block %d / %d", model, k, length(starts)))
  }
  out <- do.call(rbind, res); attr(out, "n_fail") <- n_fail; out
}

# One-day VaR/ES forecasts for target days i0..n, two tail estimates from the same fit:
#   pv*/pe* = parametric quantile / ES of the fitted distribution
#   fv*/fe* = filtered historical simulation (empirical quantile of the window's standardized residuals)
roll_risk <- function(x, i0, model, window, refit_every, alphas = c(0.01, 0.025, 0.05),
                      mean0 = FALSE, dist = "std", verbose = FALSE) {
  n <- length(x)
  stopifnot(i0 > window)
  starts <- seq(i0, n, by = refit_every)
  out <- vector("list", length(starts))
  for (k in seq_along(starts)) {
    s <- starts[k]; e <- min(s + refit_every - 1, n); m <- e - s
    fit <- fit_safe(model, x[(s - window):(e - 1)], m, mean0, dist)
    row <- data.frame(idx = s:e, mu = NA_real_, sigma = NA_real_)
    for (a in alphas) for (p in c("pv", "pe", "fv", "fe")) row[[paste0(p, tag(a))]] <- NA_real_
    if (!is.null(fit)) {
      fc <- ugarchforecast(fit, n.ahead = 1, n.roll = m)
      row$mu <- as.numeric(fitted(fc)); row$sigma <- as.numeric(sigma(fc))
      cf <- coef(fit); z <- as.numeric(residuals(fit, standardize = TRUE))
      for (a in alphas) {
        qe <- dist_q_es(dist, a, cf)
        qz <- quantile(z, a, type = 7, names = FALSE); ez <- mean(z[z <= qz])
        row[[paste0("pv", tag(a))]] <- row$mu + row$sigma * qe["q"]
        row[[paste0("pe", tag(a))]] <- row$mu + row$sigma * qe["es"]
        row[[paste0("fv", tag(a))]] <- row$mu + row$sigma * qz
        row[[paste0("fe", tag(a))]] <- row$mu + row$sigma * ez
      }
    }
    out[[k]] <- row
    if (verbose && k %% 10 == 0) message(sprintf("  %s: block %d / %d", model, k, length(starts)))
  }
  do.call(rbind, out)
}

# Historical-simulation benchmark: VaR/ES from the previous `win` returns (target day excluded)
hs_risk <- function(x, i0, alphas = c(0.01, 0.025, 0.05), win = 250) {
  n <- length(x); idx <- i0:n
  stopifnot(i0 > win)
  df <- data.frame(idx = idx, sigma = NA_real_)
  for (a in alphas) { df[[paste0("v", tag(a))]] <- NA_real_
                      df[[paste0("e", tag(a))]] <- NA_real_ }
  for (j in seq_along(idx)) {
    w <- x[(idx[j] - win):(idx[j] - 1)]
    df$sigma[j] <- sd(w)
    for (a in alphas) {
      q <- quantile(w, a, type = 1, names = FALSE)
      df[[paste0("v", tag(a))]][j] <- q
      df[[paste0("e", tag(a))]][j] <- mean(w[w <= q])
    }
  }
  df
}
