# Model specification, robust fitting and distribution quantiles.
# Requires library(rugarch) to be attached.

make_spec <- function(model, mean0 = FALSE, dist = "std") {
  ugarchspec(
    variance.model     = list(model = model, garchOrder = c(1, 1)),
    mean.model         = list(armaOrder = c(0, 0), include.mean = !mean0),
    distribution.model = dist
  )
}

# Fit with fallback solvers; returns NULL if no solver converges.
# `m` = number of trailing observations in `dat` held out of estimation (for rolling filters).
fit_safe <- function(model, dat, m = 0, mean0 = FALSE, dist = "std",
                     solvers = c("hybrid", "nlminb", "solnp")) {
  for (sv in solvers) {
    fit <- tryCatch(suppressWarnings(
      ugarchfit(make_spec(model, mean0, dist), data = dat, out.sample = m, solver = sv)),
      error = function(e) NULL)
    if (!is.null(fit) && convergence(fit) == 0) return(fit)
  }
  NULL
}

# Unit-variance Student-t used by rugarch ("std"): z = T * sqrt((nu-2)/nu), T ~ t(nu).
# Left tail, so VaR and ES are negative.
std_t_var <- function(alpha, nu) qt(alpha, nu) * sqrt((nu - 2) / nu)
std_t_es  <- function(alpha, nu) {
  ta <- qt(alpha, nu)
  -dt(ta, nu) / alpha * (nu + ta^2) / (nu - 1) * sqrt((nu - 2) / nu)
}

# Quantile and ES (as multiples of sigma) for "std" or "sstd" from fitted coefficients
dist_q_es <- function(dist, a, cf) {
  nu <- unname(cf["shape"])
  if (dist == "std") return(c(q = std_t_var(a, nu), es = std_t_es(a, nu)))
  xi <- unname(cf["skew"])
  qf <- function(u) qdist("sstd", u, mu = 0, sigma = 1, skew = xi, shape = nu)
  es <- tryCatch(integrate(qf, 0, a, rel.tol = 1e-6)$value / a,
                 error = function(e) mean(qf((seq_len(2000) - 0.5) / 2000 * a)))
  c(q = qf(a), es = es)
}
