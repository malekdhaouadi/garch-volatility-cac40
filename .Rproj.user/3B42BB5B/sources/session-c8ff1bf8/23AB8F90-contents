## One-day out-of-sample forecasts

```{r}
#| label: tbl-oos
#| tbl-cap: "One-day-ahead variance forecasts, CAC 40, last 500 days (squared demeaned return as proxy)."
oos <- read.csv(out("oos_forecasts.csv"))
qlike <- function(r, f) r / f - log(r / f) - 1
dm <- function(l1, l2) { d <- l1 - l2; z <- mean(d) / sqrt(var(d) / length(d)); 2 * pnorm(-abs(z)) }
Lg <- qlike(oos$real, oos$garch); Le <- qlike(oos$real, oos$egarch)
Sg <- (oos$real - oos$garch)^2;   Se <- (oos$real - oos$egarch)^2
kable(data.frame(Loss = c("QLIKE", "MSE"),
                 GARCH = c(sci(mean(Lg), 4), sci(mean(Sg), 4)),
                 EGARCH = c(sci(mean(Le), 4), sci(mean(Se), 4)),
                 `DM p-value` = c(sci(dm(Lg, Le), 2), sci(dm(Sg, Se), 2)),
                 check.names = FALSE), booktabs = TRUE, align = "lrrr")
```

EGARCH has the lower average loss under both measures (@tbl-oos), but the QLIKE difference is not
statistically significant (p = 0.67). The squared-error difference is (p = 0.016), but that loss is more
sensitive to a few extreme days than QLIKE, so the evidence for EGARCH out-of-sample is weak, even though
it is clearly preferred in-sample. All 10 refits per model converged.

## Forecasts against VSTOXX

```{r}
#| label: tbl-iv-stoxx
#| tbl-cap: "EURO STOXX 50 (like for like): 21-day forecasts against VSTOXX and realized volatility, 3,886 origins from 2011-03-23 (vol points, annualized). Mean error = forecast minus realized."
iv_table <- function(label) {
  d <- iv_load(label)
  f <- list(GARCH = d$garch, EGARCH = d$egarch, VSTOXX = d$implied)
  rmse <- function(a, b) sqrt(mean((a - b)^2)); dem <- function(v) v - mean(v)
  data.frame(
    Series = names(f),
    `Corr. with VSTOXX` = fx(c(cor(d$garch, d$implied), cor(d$egarch, d$implied), NA), 3),
    `Mean error` = fx(sapply(f, function(x) mean(x - d$rv_fwd)), 2),
    RMSE = fx(sapply(f, function(x) rmse(x, d$rv_fwd)), 2),
    `Corr. with realized` = fx(sapply(f, function(x) cor(x, d$rv_fwd)), 3),
    `RMSE, mean removed` = fx(sapply(f, function(x) rmse(dem(x), dem(d$rv_fwd))), 2),
    check.names = FALSE, row.names = NULL)
}
kable(iv_table("STOXX50E"), booktabs = TRUE, align = "lrrrrr")
```

```{r}
#| label: tbl-iv-cac
#| tbl-cap: "CAC 40 (VSTOXX as a proxy): same measures, 4,769 origins from 2008-01-02."
kable(iv_table("CAC40"), booktabs = TRUE, align = "lrrrrr")
```

```{r}
#| label: tbl-vrp
#| tbl-cap: "Variance risk premium: VSTOXX minus realized volatility over the following 21 trading days (vol points; Newey-West lag 20)."
vrp_row <- function(label, name) {
  d <- iv_load(label); v <- d$implied - d$rv_fwd
  data.frame(Run = name, Origins = nrow(d), `Mean premium` = fx(mean(v)),
             `NW s.e.` = fx(nw_se(v)), `Share positive (%)` = fx(100 * mean(v > 0), 0),
             check.names = FALSE)
}
kable(rbind(vrp_row("STOXX50E", "EURO STOXX 50"), vrp_row("CAC40", "CAC 40")),
      booktabs = TRUE, row.names = FALSE, align = "lrrrr")
```

```{r}
#| label: tbl-dm
#| tbl-cap: "Diebold-Mariano tests on squared error against realized volatility, Newey-West lag 20. Statistic (p-value); a positive statistic means the second model has the lower loss."
iv_dm <- function(label) {
  d <- iv_load(label)
  loss  <- function(f) (f - d$rv_fwd)^2
  lossd <- function(f) ((f - mean(f)) - (d$rv_fwd - mean(d$rv_fwd)))^2
  r <- list("GARCH vs EGARCH, raw"                 = dm_hac(loss(d$garch)   - loss(d$egarch)),
            "GARCH vs EGARCH, mean removed"        = dm_hac(lossd(d$garch)  - lossd(d$egarch)),
            "EGARCH vs VSTOXX, mean removed"       = dm_hac(lossd(d$egarch) - lossd(d$implied)),
            "GARCH vs VSTOXX, mean removed"        = dm_hac(lossd(d$garch)  - lossd(d$implied)))
  sapply(r, function(x) sprintf("%+.2f (%s)", x["stat"], pf(x["p"])))
}
dm_s <- iv_dm("STOXX50E"); dm_c <- iv_dm("CAC40")
kable(data.frame(Comparison = names(dm_s), `EURO STOXX 50` = unname(dm_s), `CAC 40` = unname(dm_c),
                 check.names = FALSE), booktabs = TRUE, align = "lrr")
```

VSTOXX exceeded subsequently realized volatility by about 3.2 vol points on the EURO STOXX 50 run
and 3.9 on the CAC 40 run, on roughly 80% of origins (@tbl-vrp), consistent with a variance risk premium.
Ranking the series by how well they track realized volatility (@tbl-iv-stoxx, @tbl-iv-cac), VSTOXX has the
highest correlation with realized volatility (0.65 and 0.69 against 0.55 to 0.62 for the models) and the
lowest RMSE once mean levels are removed. After that adjustment, VSTOXX is significantly better than EGARCH
(p = 0.026 and 0.003) and than GARCH (p = 0.002 and 0.001), while GARCH and EGARCH are indistinguishable
(p = 0.45 and 0.46) (@tbl-dm). EGARCH's lower raw RMSE on the EURO STOXX 50 (7.42 against 7.95; p = 0.024)
reflects a smaller bias (mean error +0.05 against +2.47) and not better tracking; on the CAC 40 the raw
difference is not distinguishable from zero (p = 0.945).

```{r}
