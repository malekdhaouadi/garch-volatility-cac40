```{r}
#| label: setup
library(knitr)
out <- function(f) file.path("..", "outputs", f)

sci <- function(x, d = 3) formatC(x, format = "g", digits = d)
fx  <- function(x, d = 2) unname(ifelse(is.na(x), "n/a", formatC(x, format = "f", digits = d)))
pf  <- function(p) unname(ifelse(is.na(p), "n/a",
         ifelse(p < 0.001, formatC(p, format = "e", digits = 1), formatC(p, format = "f", digits = 3))))

# Newey-West (Bartlett) standard error of a mean; 21-day windows overlap, so lag 20
nw_se <- function(x, lag = 20) {
  x <- x - mean(x); n <- length(x); s <- sum(x^2) / n
  for (k in 1:lag) s <- s + 2 * (1 - k / (lag + 1)) * sum(x[(k + 1):n] * x[1:(n - k)]) / n
  sqrt(s / n)
}
dm_hac <- function(d) { z <- mean(d) / nw_se(d); c(stat = z, p = 2 * pnorm(-abs(z))) }
iv_load <- function(label) {
  d <- read.csv(out(sprintf("ext_iv_comparison_%s.csv", label)))
  d[complete.cases(d), ]
}
```

