r <- readRDS("data/returns.rds")   # this is 2026-10-26 data
fit_g_paper <- fit_safe("sGARCH", as.numeric(r), dist = "std")
fit_e_paper <- fit_safe("eGARCH", as.numeric(r), dist = "std")
fc_g_paper <- ugarchforecast(fit_g_paper, n.ahead = 30)
fc_e_paper <- ugarchforecast(fit_e_paper, n.ahead = 30)
tail(as.numeric(sigma(fit_g_paper)), 1) * sqrt(252) * 100
tail(as.numeric(sigma(fit_e_paper)), 1) * sqrt(252) * 100
sqrt(mean((as.numeric(sigma(fc_g_paper))*sqrt(252)*100/100)^2))*100
sqrt(mean((as.numeric(sigma(fc_e_paper))*sqrt(252)*100/100)^2))*100
