library(quantmod)
r <- function(s) { p <- Ad(getSymbols(s, from = "2007-04-01", to = "2026-10-27",
auto.assign = FALSE))
p <- p[!is.na(p)]; na.omit(diff(log(p))) }
both <- na.omit(merge(r("^FCHI"), r("^STOXX50E"), join = "inner"))
cor(both)[1, 2]                 # all common days
cor(both["2008/2009"])[1, 2]    # GFC
cor(both["2020"])[1, 2]         # COVID
apply(both, 2, sd) * sqrt(252)  # annualized volatility of each index
